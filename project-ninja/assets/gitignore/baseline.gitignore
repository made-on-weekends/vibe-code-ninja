# Baseline: secrets, credentials, and a minimal OS/editor safety net.
# Personal editor/OS noise belongs in each developer's global gitignore;
# these entries exist because you cannot verify every collaborator has one.
# .gitignore prevents accidents only. It does not untrack or scrub history.

# --- Secrets & credentials ---
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
.direnv/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ppk
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
.netrc
.pypirc
client_secret*.json
service-account*.json
gha-creds-*.json

# --- Logs, temp, merge leftovers ---
*.log
*.tmp
*.orig
*.rej
/tmp/*
.cache/

# --- OS noise (safety net) ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Editor noise (safety net) ---
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
